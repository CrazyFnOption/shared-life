# Configuration reference only: server.main reads the process environment.
# This file is NOT loaded automatically. Do not commit a file with real secrets.
SHARED_EXPENSE_DB=.local/dev.sqlite3
SHARED_EXPENSE_PORT=8765
SHARED_EXPENSE_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
SHARED_EXPENSE_SECURE_COOKIE=0

# Both features stay disabled. Explicit real-call authorization is separate.
# Only server code reads this protected owner-only file when a feature is enabled.
SHARED_EXPENSE_ALLOW_MODEL_CALLS=0
SHARED_EXPENSE_ALLOW_PLANNING_AI=0
SHARED_EXPENSE_MODEL_CALL_LIMIT=0
SHARED_EXPENSE_OPENAI_KEY_FILE=
# Fixed product model: gpt-6.1-sol; reasoning=high; service_tier=default (Standard).
# Shared application cap: USD 50 per Asia/Shanghai calendar month.
# Prices are integer USD micros per 1M tokens, except WEB per call.
# Defaults match the published Standard schedule; long-context multipliers apply.
SHARED_EXPENSE_AI_PRICE_INPUT=2000000
SHARED_EXPENSE_AI_PRICE_CACHED=100000
SHARED_EXPENSE_AI_PRICE_CACHE_WRITE=2500000
SHARED_EXPENSE_AI_PRICE_OUTPUT=10000000
SHARED_EXPENSE_AI_PRICE_WEB=10000

# Push stays off until the deployment and real-device test are authorized.
SHARED_EXPENSE_ALLOW_PUSH=0
SHARED_EXPENSE_VAPID_PRIVATE_KEY=
SHARED_EXPENSE_VAPID_PUBLIC_KEY=
SHARED_EXPENSE_VAPID_SUBJECT=

# Set to a protected local directory to enable daily backups.
# Leave empty during ordinary development. Backups are not auto-deleted.
SHARED_EXPENSE_BACKUP_DIR=
